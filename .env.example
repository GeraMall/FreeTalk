# URL WebSocket-сигналинга, встраиваемый Vite в клиент. Секретов здесь нет.
VITE_SIGNALING_URL=ws://127.0.0.1:8787/ws
VITE_API_URL=http://127.0.0.1:8790

# Публичный site key Cloudflare Turnstile. Это не секрет.
VITE_TURNSTILE_SITE_KEY=

# HTTPS endpoint latest.json для подписанных обновлений Tauri (не секрет).
FREETALK_UPDATE_ENDPOINT=

# Только для release CI/локальной подписи update bundles. Не добавлять ключ в репозиторий.
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Разрешённый origin для локального Node.js сигналинга (* только для разработки).
ALLOWED_ORIGIN=http://localhost:1420
# Accountless signaling разрешается только при явном локальном opt-in.
SIGNALING_ALLOW_INSECURE_DEVELOPMENT=false

# Cloudflare Realtime TURN: только серверные переменные Worker, не VITE_*.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=86400

# Опциональный закрытый broker: VPS получает временную ICE-конфигурацию от Worker,
# не храня основной Cloudflare TURN API token. Значения задаются только на серверах.
TURN_BROKER_URL=
TURN_BROKER_TOKEN=

# Backend API / PostgreSQL. Все значения ниже задаются только на сервере.
DATABASE_URL=postgresql://freetalk:change-me@127.0.0.1:5432/freetalk
DATABASE_SSL=false
API_HOST=127.0.0.1
API_PORT=8790
API_PUBLIC_URL=http://127.0.0.1:8790
TOKEN_PEPPER=
IP_HASH_SALT=
INTERNAL_SIGNALING_SECRET=
ACCOUNT_API_URL=http://127.0.0.1:8790

# Cloudflare Turnstile secret используется только API.
TURNSTILE_SECRET_KEY=
# Только для локальной разработки без облачного аккаунта. В production всегда false.
CAPTCHA_BYPASS_LOCAL=false

# Email verification/reset. Production API отказывается стартовать в режиме log.
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FreeTalk <noreply@example.com>
