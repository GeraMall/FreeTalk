{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeTalk Admin",
  "version": "0.1.0",
  "identifier": "io.freetalk.admin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8790 https://freetalk.191-44-38-60.sslip.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "FreeTalk Admin",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
