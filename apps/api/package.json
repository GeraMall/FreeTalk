{
  "name": "@freetalk/api",
  "version": "0.4.0-beta.46",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/web-push-vendor-entry.ts --bundle --platform=node --format=cjs --outfile=vendor/web-push.cjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "admin:grant": "tsx src/grant-admin.ts",
    "mobile-beta:generate": "tsx src/generate-mobile-beta-keys.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "esbuild src/web-push-vendor-entry.ts --bundle --platform=node --format=cjs --outfile=vendor/web-push.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.4",
    "@freetalk/config": "workspace:*",
    "@freetalk/protocol": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.44.0",
    "fastify": "^5.12.7",
    "firebase-admin": "14.5.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-push": "^3.6.7"
  }
}
