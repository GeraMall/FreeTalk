# Merge these entries into the EXISTING /etc/freetalk/api.env (root:root, 0600).
# Keep all existing SMTP, CAPTCHA, token, VAPID and security settings consistent.
API_HIGH_AVAILABILITY=true
API_HOST=10.60.0.11
API_PORT=8790
API_TRUSTED_PROXIES=127.0.0.1,::1,10.60.0.11,10.60.0.12
API_PUBLIC_URL=https://trlka.com/api
ALLOWED_ORIGIN=https://trlka.com,https://tauri.localhost,tauri://localhost
DATABASE_URL=postgres://trlka_api:REPLACE@db.internal:5432/trlka
DATABASE_SSL=true
SIGNALING_INTERNAL_URL=http://10.60.0.11:8786
# The same TOKEN_PEPPER, INTERNAL_SIGNALING_SECRET, IP_HASH_SALT and VAPID keys on API replicas.
# Do not generate independent token secrets for each replica: sessions must survive failover.
