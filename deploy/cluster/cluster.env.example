# Root-owned /etc/trlka/cluster.env, mode 0600. Same private database for all nodes.
# Use a managed HA PostgreSQL endpoint or a separately operated quorum-based cluster.
SIGNALING_CLUSTER_DATABASE_URL=postgres://trlka_cluster:REPLACE@db.internal:5432/trlka
SIGNALING_CLUSTER_DATABASE_SSL=true
SIGNALING_NODE_ID=voice-a
# Addresses below MUST be private encrypted-network addresses, not public listeners.
SIGNALING_NODE_URL=http://10.60.0.11:8787/
SIGNALING_HOST=10.60.0.11
PORT=8787
# Administrative room cap, not a benchmark or promise of user capacity.
SIGNALING_NODE_CAPACITY=100
SIGNALING_LEASE_MS=15000
SIGNALING_RECOVERY_MS=120000
GATEWAY_HOST=10.60.0.11
GATEWAY_PORT=8786
ACCOUNT_API_URL=http://127.0.0.1:8801/api
INTERNAL_SIGNALING_SECRET=REPLACE_WITH_EXISTING_SHARED_SECRET_AT_LEAST_32_CHARACTERS
# Comma-separated API origins go in api.env. Signaling takes one origin or '*'.
ALLOWED_ORIGIN=*
# Supply existing TURN provider configuration privately; never commit credentials.
# TURN_KEY_ID=...
# TURN_KEY_API_TOKEN=...
