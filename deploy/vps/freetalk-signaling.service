[Unit]
Description=FreeTalk signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freetalk
Group=freetalk
EnvironmentFile=/etc/freetalk/signaling.env
WorkingDirectory=/opt/freetalk
ExecStart=/usr/bin/node /opt/freetalk/server.bundle.mjs
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
